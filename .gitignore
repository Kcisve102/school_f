# Environment variables
.env
.env.local
.env.*.local
# Every other .env variant (.env.production, .env.staging, ...):
# they carry real credentials. .env.example is the one exception.
.env*
!.env.example

# Local .env backups — never commit, they carry real credentials
.env.bak.*

